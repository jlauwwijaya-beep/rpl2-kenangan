@inherits LayoutComponentBase

<div class="page">
    <div class="jungle-bg" aria-hidden="true">
        <span class="jb jb1">🌳</span>
        <span class="jb jb2">🌴</span>
        <span class="jb jb3">🌿</span>
        <span class="jb jb4">🍃</span>
        <span class="jb jb5">🦜</span>
        <span class="jb jb6">🐒</span>
        <span class="jb jb7">🌱</span>
        <span class="jb jb8">🌳</span>
    </div>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="top-note">XII RPL 2 — kenangan kita, selamanya</span>
